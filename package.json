{
  "name": "saythrough",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "^7.3.13",
    "@react-navigation/native-stack": "^7.18.5",
    "expo": "~57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.6",
    "expo-image-picker": "~57.0.6",
    "expo-speech": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "jszip": "^3.10.1",
    "onnxruntime-web": "^1.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@playwright/test": "^1.62.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.4.2",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "rm -rf dist && node scripts/voice/build-runtime.mjs && node scripts/voice/build-phonemizer.mjs && EXPO_BASE_URL=/app EXPO_PUBLIC_BASE_URL=/app expo export --platform web --output-dir dist/app && node scripts/postbuild-web.mjs && node scripts/build-site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "e2e": "npm run build && playwright test",
    "og-image": "node scripts/gen-og-image.mjs",
    "lexicon": "node scripts/prediction/download-lexicon.mjs en && node scripts/prediction/build-lexicon.mjs en",
    "voice": "node scripts/voice/download-voice.mjs",
    "lint": "tsc --noEmit",
    "check-symbols": "node scripts/symbols/check-seed-coverage.mjs",
    "check-deploy": "node scripts/check-deploy.mjs"
  },
  "private": true
}
